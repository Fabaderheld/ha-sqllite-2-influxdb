SQLITE_DB=/path/to/home-assistant_v2.db
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_token
INFLUXDB_ORG=your_org
INFLUXDB_BUCKET=your_bucket

BATCH_SIZE=5000
DEBUG_MODE=false
SOURCE_TAG=HA
INCLUDE_ATTRIBUTES=true

# Optional: regex of entity IDs to skip. Leave empty to keep everything.
# Example: (^automation\.|^media_player\.|_uptime$|_wifi_signal$)
EXCLUDE_ENTITY_ID_REGEX=

# Optional: restrict the "oldest existing point" lookup to a given source tag.
# Leave empty to scan the whole bucket. Must not contain quotes or backslashes.
INFLUX_SOURCE_FILTER=
